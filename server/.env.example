# Copy this file to server/.env ON THE VPS ONLY.
# Never commit the real .env. GitHub Actions does not upload or overwrite it.
#
# Two copies, one per site. Same VPS, different folder, port, database, and PM2 name.
#
# Production — branch ucasaappmain_final_deploy — https://www.ucasaapp.com
#   PM2_APP_NAME=cas-live
#   PORT=3004
#   APP_ENV=live
#   CLIENT_URL=https://www.ucasaapp.com
#   BUILD_PATH=/home/ucasaapp/htdocs/ucasaapp.com/server/build
#   MONGODB_URI=mongodb://USER:PASSWORD@HOST:PORT/casai?authSource=casai
#   REDIS_DB=0
#   GOOGLE_CALLBACK_URL=https://www.ucasaapp.com/api/auth/google/callback
#   ATOZAS_REDIRECT_URI=https://www.ucasaapp.com/auth/atozas/callback
#
# Test — branch ucasaapptest_testCICD_testSite_deploy — https://casai.testatozas.in
#   PM2_APP_NAME=cas-test
#   PORT=3005
#   APP_ENV=test
#   CLIENT_URL=https://casai.testatozas.in
#   BUILD_PATH=/home/ucasaapp/htdocs/casai.testatozas.in/server/build
#   MONGODB_URI=mongodb://USER:PASSWORD@HOST:PORT/casai_test?authSource=casai
#   REDIS_DB=1
#   GOOGLE_CALLBACK_URL=https://casai.testatozas.in/api/auth/google/callback
#   ATOZAS_REDIRECT_URI=https://casai.testatozas.in/auth/atozas/callback

# Server
PORT=3004
APP_ENV=live
NODE_ENV=production
PM2_APP_NAME=cas-live
CLIENT_URL=https://www.ucasaapp.com
CORS_ORIGINS=https://ucasaapp.com,https://www.ucasaapp.com,https://casai.testatozas.in,https://www.casai.testatozas.in
BUILD_PATH=/home/ucasaapp/htdocs/ucasaapp.com/server/build

# MongoDB — test and production must use different database names
MONGODB_URI=mongodb://USER:PASSWORD@HOST:PORT/casai?authSource=casai

# Redis — logical DB 0 is production, DB 1 is test (same Redis server is fine)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# SMTP
SMTP_NAME=atozas.com
SMTP_SERVER=mail.atozas.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_EMAIL=no-reply@atozas.com
SMTP_EMAIL_PASSWORD=replace-me
SMTP_FROM=Collision Avoidance System <no-reply@atozas.com>
SMTP_TLS_REJECT_UNAUTHORIZED=false

# AI Provider (openai | groq | deepseek)
AI_PROVIDER=groq
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Google OAuth — web client used by this site
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://www.ucasaapp.com/api/auth/google/callback
GOOGLE_CALLBACK_URLS=https://ucasaapp.com/api/auth/google/callback,https://www.ucasaapp.com/api/auth/google/callback,https://casai.testatozas.in/api/auth/google/callback
PUBLIC_API_URL=/api/v1
PUBLIC_GOOGLE_CLIENT_ID=
PUBLIC_GOOGLE_CLIENT_ID_BY_ORIGIN=
REACT_APP_GOOGLE_CLIENT_ID=

# Google Maps JavaScript API key (restrict by HTTP referrer in Google Cloud)
GOOGLE_MAPS_API_KEY=

# Risk Engine Defaults
PROXIMITY_THRESHOLD_METERS=500
CRITICAL_DISTANCE_METERS=20
PROXIMITY_ALERT_METERS=50
GPS_UPDATE_INTERVAL_MS=3000

# Risk Weight Configuration
WEIGHT_PROXIMITY=0.35
WEIGHT_RELATIVE_SPEED=0.30
WEIGHT_DIRECTION_ALIGNMENT=0.20
WEIGHT_ACCELERATION=0.15

# Socket.IO
SOCKET_PING_INTERVAL=10000
SOCKET_PING_TIMEOUT=5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info

# ATOZAS SSO
ATOZAS_SSO_ENABLED=true
ATOZAS_ISSUER=https://www.ucasaapp.com/atozaswebsite/sso
ATOZAS_CLIENT_ID=ucasaapp
ATOZAS_CLIENT_SECRET=replace-me
ATOZAS_REDIRECT_URI=https://www.ucasaapp.com/auth/atozas/callback
ATOZAS_SCOPE=openid email profile
ATOZAS_AUTHORIZE_URL=https://www.ucasaapp.com/atozaswebsite/sso/authorize
ATOZAS_TOKEN_URL=https://www.ucasaapp.com/atozaswebsite/sso/token
ATOZAS_USERINFO_URL=https://www.ucasaapp.com/atozaswebsite/sso/userinfo
ATOZAS_REVOKE_URL=https://www.ucasaapp.com/atozaswebsite/sso/revoke
ATOZAS_TOKEN_AUTH_STYLE=body
ATOZAS_HOMEPAGE_KEY=ucasaapp
ATOZAS_SESSION_COOKIE_NAME=cas_atozas_sid
ATOZAS_SESSION_SECRET=replace-with-a-long-random-string
ATOZAS_SESSION_MAX_AGE_DAYS=30
ATOZAS_SESSION_COLLECTION=atozas_sessions
ATOZAS_COOKIE_SECURE=true
ATOZAS_COOKIE_SAMESITE=lax
ATOZAS_AUTO_REDIRECT=false
